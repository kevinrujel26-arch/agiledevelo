# Copia este archivo como .env y ajusta los valores
NODE_ENV=development
PORT=3000

# Base de datos (docker-compose levanta PostgreSQL con estos datos)
DATABASE_URL=postgres://alquiler:alquiler@localhost:5432/alquiler_maquinaria
# Base de datos para las pruebas automatizadas (se BORRA en cada ejecución)
DATABASE_URL_TEST=postgres://alquiler:alquiler@localhost:5432/alquiler_maquinaria_test
# true cuando la BD está en la nube (Render, Neon, Supabase...)
DB_SSL=false

# Clave para firmar los tokens. Genera una larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# URL del frontend (para CORS). Varias separadas por coma.
CORS_ORIGIN=http://localhost:5173

# Carpeta donde se guardan las fotos subidas
UPLOAD_DIR=uploads

# Zona horaria del negocio (para saber qué día es "hoy")
APP_TZ=America/Lima

# Administrador inicial que crea "npm run db:sembrar"
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@alquiler.pe
ADMIN_CONTRASENA=Admin12345
