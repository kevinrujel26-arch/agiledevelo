# Copia este archivo como .env (en la carpeta backend) y ajusta los valores
APP_ENV=development
PORT=3000

# Base de datos (docker-compose levanta PostgreSQL en el puerto 5433)
DATABASE_URL=postgres://alquiler:alquiler@localhost:5433/alquiler_maquinaria
# Base de datos para las pruebas automatizadas (se BORRA en cada ejecuciÃ³n de "mvn test")
DATABASE_URL_TEST=postgres://alquiler:alquiler@localhost:5433/alquiler_maquinaria_test
# true cuando la BD estÃ¡ en la nube (Neon, Render...)
DB_SSL=false

# Clave para firmar los tokens (mÃ­nimo 16 caracteres, larga y aleatoria)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# URL del frontend (CORS). Varias separadas por coma.
CORS_ORIGIN=http://localhost:5173

# Carpeta donde se guardan las fotos subidas (ya casi no se usa: ver Cloudinary abajo)
UPLOAD_DIR=uploads

# Cloudinary: guarda las fotos de las mÃ¡quinas de forma permanente (gratis).
# Crea una cuenta en https://cloudinary.com/users/register/free y copia estos
# 3 datos desde tu Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# "Continuar con Google": Client ID de tipo "AplicaciÃ³n web" de Google Cloud Console
# (termina en .apps.googleusercontent.com). Es el mismo valor que VITE_GOOGLE_CLIENT_ID
# del frontend. No se usa Client Secret. VacÃ­o = inicio con Google desactivado.
GOOGLE_CLIENT_ID=

# Zona horaria del negocio (para saber quÃ© dÃ­a es "hoy")
APP_TZ=America/Lima

# Administrador inicial que crea el comando "sembrar"
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@alquiler.pe
ADMIN_CONTRASENA=Admin12345
ADMIN_TELEFONO=987654321

# Pago en línea con Mercado Pago (Checkout Pro). Access Token de PRUEBA de tu aplicación
# (Tus integraciones > Credenciales de prueba). Vacío = pago en línea desactivado.
MP_ACCESS_TOKEN=
# Dirección del frontend (a donde vuelve el cliente tras pagar) y de esta API (Mercado Pago avisa aquí del pago).
# En producción: https://agiledevelo.vercel.app y https://agiledevelo.onrender.com
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Monto máximo (en soles) hasta el cual se ofrece Yape; por encima de este monto no aparece
MP_YAPE_MAX=500

# Clave pública de Mercado Pago (Credenciales de prueba > Public Key). Para el formulario de tarjeta; no es secreta.
MP_PUBLIC_KEY=

# true: formulario de tarjeta dentro de la pagina (requiere credenciales que permitan pagos por API). false: redirige a Mercado Pago
MP_PAGO_EN_PAGINA=false
