{
  "name": "alquiler-maquinaria-backend",
  "version": "0.2.0",
  "description": "API REST del sistema de alquiler de maquinaria (Sprints 1 y 2)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrar": "node scripts/migrar.js",
    "db:sembrar": "node scripts/sembrar.js",
    "db:reiniciar": "node scripts/migrar.js --reiniciar && node scripts/sembrar.js",
    "test": "jest --runInBand",
    "test:cobertura": "jest --runInBand --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/configuracion/entorno.js"
    ],
    "globalSetup": "<rootDir>/tests/configuracion/preparar-bd.js",
    "testTimeout": 20000
  }
}
