# Solo en producción: URL pública del backend (sin / al final).
# En desarrollo déjalo vacío: Vite redirige /api al backend local.
VITE_API_URL=

# "Continuar con Google": el mismo Client ID que GOOGLE_CLIENT_ID del backend.
# Vacío = no se muestra el botón de Google.
VITE_GOOGLE_CLIENT_ID=

# Alcance funcional de la entrega: 4 = Milestone 1 (HU1-HU4), 5 = suma HU5 (panel admin), 6 = suma HU6 (reservas).
# Por defecto es 4. Debe coincidir con ALCANCE_HU del backend.
VITE_ALCANCE_HU=4
